#!/bin/bash
# fake PBS qsub: queues the script, "starts" it after $FAKE_QUEUE_SECS (default 8) seconds
script="$1"; [ -f "$script" ] || { echo "qsub: script file:: No such file or directory" >&2; exit 2; }
n=$(( $(cat /tmp/pbs/counter 2>/dev/null || echo 7000000) + 1 )); echo $n > /tmp/pbs/counter
id="$n.kman.restech.unsw.edu.au"
name=$(grep -m1 '^#PBS -N' "$script" | awk '{print $3}'); name=${name:-$(basename "$script")}
d=/tmp/pbs/jobs/$n; mkdir -p $d
echo "$id" > $d/id; echo "$name" > $d/name; echo "$(whoami)" > $d/owner; echo Q > $d/state
echo "Not Running: Insufficient amount of resource: mem" > $d/comment
abs=$(cd "$(dirname "$script")" && pwd)/$(basename "$script")
( sleep ${FAKE_QUEUE_SECS:-8}
  [ -d $d ] || exit 0
  echo R > $d/state; echo "localhost/0" > $d/exec_host; echo "Job run at $(date) on (localhost:ncpus=1:mem=100663296kb)" > $d/comment
  cd ~ && PBS_JOBID=$id setsid bash -c 'echo $$ > "$0"; exec bash "$1"' "$d/pid" "$abs" > ~/"$name.o$n" 2> ~/"$name.e$n"
  [ "$(cat $d/state 2>/dev/null)" = E ] || rm -rf $d ) >/dev/null 2>&1 &
disown
echo "$id"
